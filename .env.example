# Скопируйте в .env и поменяйте секреты для любого не-локального запуска.
SECRET_KEY=change-me-long-random-string
ADMIN_TOKEN=change-me-admin-token
# Ключи локального хранилища — как в deploy/seaweedfs-s3.json
S3_ACCESS_KEY=pokazhdu
S3_SECRET_KEY=pokazhdu-local-secret
S3_BUCKET=clips
# Адрес хранилища, доступный браузеру (подпись URL включает хост)
S3_PUBLIC_ENDPOINT=http://localhost:9000
CONTACT_EMAIL=hello@pokazhdu.example
CLIP_URL_TTL=600
GOLD_RATE=0.12
